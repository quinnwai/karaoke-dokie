SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Full URL Spotify redirects back to, e.g. http://127.0.0.1:3000/api/auth/callback
SPOTIFY_REDIRECT_URI=
# Random string, 32+ characters, used to sign the session cookie
SESSION_SECRET=
# Postgres connection string (Neon). Leave empty and set KARAOKE_STORE=memory for local dev.
DATABASE_URL=
KARAOKE_STORE=
# Token for the hidden admin log page
ADMIN_TOKEN=
USDB_USERNAME=
USDB_PASSWORD=
# 1 = use the built-in offline Spotify mock (user "Test Singer"); for e2e tests and local dev
SPOTIFY_MOCK=
# Beta event log: on or off. Empty = on only for a production build with real Spotify and the
# Postgres store, off everywhere else (tests, e2e, local dev). Any other value counts as off.
EVENTS=
# Duets and moods on screen: on or off. Empty = off, and any other value counts as off, so a typo never
# turns them on (QWW-43). While off, the API sends no mood labels and no duet markers.
DUETS_AND_MOODS=
# Moods allowed on screen as chips, once they pass the QWW-11 gate, e.g. upbeat,heartfelt. Empty = none.
# Read only while DUETS_AND_MOODS is on.
MOODS_SHIPPED=
# The title screen's "or pick songs you sing well" link and the range screen's "or use songs from your Spotify"
# link: on or off together. Empty = off, and any other value counts as off, so a typo never turns it on
# (QWW-55): the first tester release has one onboarding flow, and the Spotify logo on the list is its sign-in.
PICK_SONGS=
